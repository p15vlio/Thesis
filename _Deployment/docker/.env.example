# Environment of the Docker Compose stack. The one-click script (start-all.bat / start-all.sh) creates
# ".env" from this file automatically, with freshly generated random secrets, and never overwrites an
# existing ".env". To do it by hand:
#   cp .env.example .env        (Windows: copy .env.example .env)
# and replace both secrets with long random values, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
# ".env" is git-ignored; this example file is the only one that is committed. Never commit real secrets.

# Database name and credentials. These three match the defaults of seed_admin.py and seed_data.py,
# so seeding works without extra variables. If you change them, pass the same values to the seed
# scripts (DB_NAME, DB_USER, DB_PASSWORD).
POSTGRES_DB=opendelivery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=opendelivery

# Mandatory: the backend refuses to start without a non-blank value for each of them.
# JWT_SECRET signs the access tokens; SETTINGS_SECRET is the source of the key that encrypts the
# stored external-service secrets (SMTP password, GEMH key, delivery-platform keys).
# They are left empty on purpose: Docker Compose stops with "JWT_SECRET must be set" until you fill
# them in (the one-click script does it for you). Use 64 random hex characters for each.
# Changing SETTINGS_SECRET later makes the already stored secrets unreadable (enter them again).
JWT_SECRET=
SETTINGS_SECRET=

# Address of this PC as seen from the kiosk tablet (embedded in the device QR codes).
# Use your LAN address when a tablet is involved, e.g. http://192.168.1.20:8080
PUBLIC_API_URL=http://localhost:8080

# Optional. Login address of the web panel used in the owner welcome e-mail (default http://localhost).
# PUBLIC_FRONTEND_URL=http://localhost
# Optional. Seconds between the status changes of the emulated delivery platforms (default 45).
# FOOD_PLATFORM_STEP_SECONDS=45
